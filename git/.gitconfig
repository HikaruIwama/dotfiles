[user]
	name = HikaruIwama
	email = 174074039+HikaruIwama@users.noreply.github.com
	signingkey = ~/.ssh/id_ed25519.pub

[gpg]
	format = ssh

[commit]
	gpgsign = true

[tag]
	gpgsign = true

[init]
	defaultBranch = main

[core]
	autocrlf = input

[pull]
	ff = only

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[diff]
	algorithm = histogram
	colorMoved = default

[branch]
	sort = -committerdate
